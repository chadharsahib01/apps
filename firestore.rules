rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && request.auth.token.role in ['admin', 'superadmin']; }
  function superadmin() { return signedIn() && request.auth.token.role == 'superadmin'; }
  match /users/{uid} { allow create: if signedIn() && request.auth.uid == uid; allow read: if signedIn() && (request.auth.uid == uid || admin()); allow update: if signedIn() && request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus','suspended','role','cnicHash']); allow update: if admin(); allow delete: if false; }
  match /donors/{uid} { allow read: if signedIn(); allow create, update: if signedIn() && request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified','donationCount','nextEligibleAt']); allow update: if admin(); allow delete: if false; }
  match /requests/{requestId} { allow create: if signedIn() && request.resource.data.requesterId == request.auth.uid; allow read: if signedIn() && (resource.data.requesterId == request.auth.uid || admin()); allow update: if admin(); allow delete: if false; }
  match /hospitals/{id} { allow read: if signedIn() && resource.data.published == true; allow write: if admin(); }
  match /notifications/{id} { allow read: if signedIn() && resource.data.recipientId == request.auth.uid; allow create, update, delete: if false; }
  match /adminAuditLog/{id} { allow read: if admin(); allow write: if false; }
  match /appSettings/{id} { allow read: if signedIn(); allow write: if superadmin(); }
 }
}
